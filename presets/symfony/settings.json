{
  "symfonyLsp.phpCommand": [
    "{{runner}}",
    "php"
  ],
  "symfonyLsp.containerProjectRoot": "/app",
  "yaml.customTags": [
    "!php/const scalar",
    "!php/enum scalar",
    "!php/object scalar",
    "!tagged_iterator scalar",
    "!tagged_iterator mapping",
    "!tagged_locator scalar",
    "!tagged_locator mapping",
    "!service mapping",
    "!service_locator mapping",
    "!iterator sequence",
    "!abstract scalar",
    "!closure scalar",
    "!returns_clone sequence",
    "!service_closure scalar"
  ],
  "intelephense.files.exclude+": [
    "**/var/**"
  ],
  "files.watcherExclude": {
    "**/var/**": true
  },
  "yaml.schemas": {
    "./.vscode/presets/symfony/schemas/generated/symfony-config.schema.json": [
      "config/config*.yml",
      "config/config*.yaml",
      "config/security*.yml",
      "config/security*.yaml",
      "config/packages/**/*.yml",
      "config/packages/**/*.yaml"
    ],
    "./.vscode/presets/symfony/schemas/generated/symfony-services.schema.json": [
      "config/services*.yml",
      "config/services*.yaml",
      "config/services/**/*.yml",
      "config/services/**/*.yaml",
      "**/Resources/config/services*.yml",
      "**/Resources/config/services*.yaml"
    ],
    "./.vscode/presets/symfony/schemas/generated/symfony-routing.schema.json": [
      "config/routing*.yml",
      "config/routing*.yaml",
      "config/routing/**/*.yml",
      "config/routing/**/*.yaml",
      "config/routes*.yml",
      "config/routes*.yaml",
      "config/routes/**/*.yml",
      "config/routes/**/*.yaml"
    ]
  }
}
