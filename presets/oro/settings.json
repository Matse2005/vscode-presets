{
  "symfonyLsp.phpCommand": [
    "{{runner}}",
    "php",
    "-d",
    "auto_prepend_file=/app/.vscode/presets/oro/oro-dotenv.php"
  ],
  "intelephense.files.exclude+": [
    "**/public/bundles/**",
    "**/public/build/**",
    "**/public/media/**"
  ],
  "files.watcherExclude": {
    "**/public/bundles/**": true,
    "**/public/build/**": true,
    "**/public/media/**": true
  },
  "yaml.schemas": {
    "./.vscode/presets/oro/schemas/generated/oro-acl-categories.schema.json": [
      "config/oro/acl_categories.yml",
      "config/oro/acl_categories/**/*.yml",
      "**/Resources/config/oro/acl_categories.yml"
    ],
    "./.vscode/presets/oro/schemas/generated/oro-acls.schema.json": [
      "config/oro/acls.yml",
      "config/oro/acls/**/*.yml",
      "**/Resources/config/oro/acls.yml"
    ],
    "./.vscode/presets/oro/schemas/generated/oro-actions.schema.json": [
